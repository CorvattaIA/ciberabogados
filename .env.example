# Supabase Project Configuration
# These are exposed to the client-side (Vite)
VITE_SUPABASE_URL=https://your-project-reference-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# AI API Configuration (Example)
# If your AI API calls are made from the frontend, prefix with VITE_
# If calls are made from a backend/serverless function, this key might not need VITE_ prefix
# and would be handled server-side. For this project, assuming frontend calls for simplicity.
VITE_AI_API_KEY=your_ai_provider_api_key
VITE_AI_API_ENDPOINT=https://api.your_ai_provider.com/v1/chat/completions

# General Application Settings (Examples)
# VITE_APP_TITLE="Ciberabogados IA"
# VITE_DEFAULT_LEGAL_AREA="general"

# Note:
# - Do NOT commit your actual .env file with real keys to version control.
# - Copy this file to .env (or .env.local) and fill in your actual credentials.
# - The VITE_ prefix is important for Vite projects to expose these variables
#   to your frontend code via import.meta.env.VITE_VARIABLE_NAME.
# - Variables without the VITE_ prefix are typically for use in Node.js build scripts or server-side environments
#   and are not exposed to the client by default. If you have backend secrets, manage them securely
#   (e.g., via Supabase Edge Functions secrets, or a dedicated backend).
